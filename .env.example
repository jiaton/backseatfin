# Copy to .env and fill in the part you use. Guides: docs/emby.md, docs/youtube.md.
# (Jellyfin needs none of this: it's a plugin, see docs/jellyfin.md.)

# --- Emby in the car: the car host (docs/emby.md) ------------------------------------------
# Emby as the container reaches it (LAN address or compose service name), no trailing
# slash. Leave it out if you don't use Emby.
EMBY_URL=http://192.168.1.10:8096
# Emby with the car player added. Point your HTTPS reverse proxy at it.
CAR_PORT=8097

# --- YouTube in the car: the BackseatFin server (docs/youtube.md) ---------------------------
# Uncomment to start the server: YouTube in the car, and HDR tone mapping for Emby.
# COMPOSE_PROFILES=server

# Key for signing in (once per phone; the car signs in by scanning a QR code with a
# signed-in phone). Generate one with: openssl rand -hex 24
API_KEY=
# The BackseatFin app: open it in the car. Point your HTTPS reverse proxy at it.
APP_PORT=8098

# Streams the server runs at once (YouTube passes through cheaply; Emby HDR re-encodes).
MAX_CONCURRENT_STREAMS=2
# How often followed YouTube channels and playlists are checked, in seconds (playlists
# are also re-read whenever the home screen opens).
FEED_REFRESH_INTERVAL_SECONDS=1800
# The server takes the newest yt-dlp at each start (YouTube changes; yt-dlp catches up).
# 0 keeps the version in the image.
YTDLP_AUTO_UPDATE=1

# Intel GPU for Emby's HDR / Dolby Vision films (optional; without it they're tone-mapped
# on the CPU at up to 720p). Uncomment, and set the host's `video` and `render` group IDs
# (getent group video render).
# COMPOSE_FILE=docker-compose.yml:docker-compose.intel.yml
# VIDEO_GID=44
# RENDER_GID=109

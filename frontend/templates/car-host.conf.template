# The car host: Emby's own web app, with two changes so that pressing Play in the car
# opens the canvas player instead of Emby's <video> player (which the car blocks while
# driving):
#   /web/index.html   → Emby's page with the inject.js <script> added (sub_filter)
#   /car/*            → the car player and inject.js (static files in this image)
#   /car/api/*        → the optional BackseatFin server (YouTube, HDR tone mapping); the
#                       player works without it: Emby transcodes, and the player talks to
#                       Emby with the viewer's own session
#   everything else   → Emby, untouched
# Put this port behind your HTTPS reverse proxy: the player needs a secure context.
map $http_upgrade $car_host_connection {
  default upgrade;
  ''      '';
}

server {
  listen 8080;

  # Read at request time (resolver in nginx.conf): Emby or the server restarting under
  # a new container IP doesn't need an nginx restart, and a missing server is a 502
  # (the player then lets Emby transcode) instead of nginx refusing to start.
  set $emby ${EMBY_URL};
  set $backend http://backend:8000;

  # Uploads (artwork, subtitles) go to Emby unchanged.
  client_max_body_size 0;

  # Emby's page, plus our script. Uncompressed from Emby, so sub_filter can see it.
  location ~ ^/web/(index\.html)?$ {
    proxy_pass $emby;
    proxy_set_header Host $host;
    proxy_set_header Accept-Encoding "";
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    sub_filter '</head>' '<script type="module" src="/car/inject.js"></script></head>';
    sub_filter_once on;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-cache";
  }

  # Whether the optional BackseatFin server is there (the player asks at every Play).
  # Without it: a quiet 404, not a 502 and a resolver error in the log each time.
  location = /car/health {
    proxy_pass $backend/health;
    proxy_intercept_errors on;
    error_page 502 503 504 =404 /car/no-server;
    error_log /dev/stderr crit;
  }
  location = /car/no-server {
    internal;
    return 404;
  }

  # The optional BackseatFin server: its API (with the stream WebSocket).
  location ~ ^/car/api/ {
    rewrite ^/car/(.*)$ /$1 break;
    proxy_pass $backend;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $car_host_connection;
    proxy_set_header Host $host;
    proxy_set_header User-Agent $http_user_agent;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    # A film is one long-lived stream.
    proxy_buffering off;
    proxy_read_timeout 6h;
    proxy_send_timeout 6h;
  }

  # The player's static files. Hashed assets never change under the same name; the
  # pages and inject.js (loaded by a fixed name) are revalidated so updates reach the
  # car at once.
  location /car/assets/ {
    rewrite ^/car/(.*)$ /$1 break;
    root /usr/share/nginx/html;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  location /car/ {
    rewrite ^/car/(.*)$ /$1 break;
    root /usr/share/nginx/html;
    try_files $uri $uri.html =404;
    add_header Cache-Control "no-cache";
  }

  location / {
    proxy_pass $emby;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $car_host_connection;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_buffering off;
    proxy_read_timeout 6h;
    proxy_send_timeout 6h;
  }
}
